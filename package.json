{
  "name": "market-alerts",
 "productName": "MarketAlerts",
  "version": "1.0.0",
  "description": "Market hours and alerts",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
     "dist": "electron-builder --win --publish never"
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.local.marketalerts",
    "files": ["main.js", "index.html", "build/icon.png"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
